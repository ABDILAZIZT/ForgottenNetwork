# Backend
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Development only. The server refuses this token in NODE_ENV=production.
DEV_AUTH_TOKEN=replace-with-a-long-random-development-token

# JSON fallback is for local development only; production requires PostgreSQL.
DB_PATH=./db.json

# Permanent canvas: use an absolute path on a durable disk in production.
# Unset by default: server/data/permanent.sqlite (or DB_PATH + .canvas.sqlite for isolated runs).
# PERMANENT_DB_PATH=/var/data/permanent.sqlite

# Frontend persistence mode. Keep local until the shared API is configured.
VITE_WORLD_MODE=local
VITE_API_BASE_URL=/api/v1
# Serve client/dist from Express during local single-origin testing.
SERVE_FRONTEND=false
VITE_DEV_AUTH_TOKEN=replace-with-the-same-development-token

# Ads are disabled unless a production operator completes provider, consent, and policy setup.
# These client-side IDs are public configuration, never secrets. Leave blank until approved.
ADS_ENABLED=false
VITE_ADS_ENABLED=false
VITE_ADSENSE_CLIENT_ID=
VITE_AD_MANAGER_REWARDED_UNIT=
VITE_AD_SLOT_TOP_BANNER=
VITE_AD_SLOT_SIDEBAR=
VITE_AD_SLOT_MARKETPLACE_FEED=
VITE_AD_SLOT_FOOTER=
# Transition interstitials are intentionally unused so ads cannot interrupt canvas use.
VITE_AD_SLOT_LOADING=

# Production database and sessions
DATABASE_URL=postgresql://forgotten_network:change-me@localhost:5432/forgotten_network
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
SESSION_SECRET=replace-with-at-least-32-random-characters
MIGRATE_ON_START=false

# Provider-neutral OpenID Connect
APP_ORIGIN=https://your-domain.example
OIDC_ISSUER_URL=https://your-provider.example
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me

# Optional private S3-compatible media storage; otherwise processed bytes use PostgreSQL.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
REQUEST_LOGS=true
DAILY_CHUNK_WRITES=5000
DAILY_ENTITY_WRITES=100
DAILY_ASSET_UPLOADS=30
